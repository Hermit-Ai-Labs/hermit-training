[
  {
    "type": "function",
    "function": {
      "name": "calculator",
      "description": "Evaluate an arithmetic expression exactly and return the result. Use it for any arithmetic beyond trivial; never do multi-step maths in your head. Supports + - * / ** ( ), sqrt(), ln(), log10(), exp(), abs(), min(), max(), round(x, n).",
      "parameters": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "description": "The expression to evaluate, e.g. '(2410.5 - 2311) * 0.75'."
          }
        },
        "required": [
          "expression"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_price",
      "description": "Get the live price and 24h change of a coin or token (Hyperliquid, falling back to Binance). Always call this before stating a current price; never invent prices.",
      "parameters": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Ticker, e.g. 'BTC', 'ETH', 'SOL', 'HYPE'."
          }
        },
        "required": [
          "symbol"
        ]
      }
    }
  },
  {
