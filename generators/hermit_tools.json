        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "description": "Optional chain filter, e.g. 'ethereum', 'base', 'arbitrum', 'bsc', 'solana', 'hyperliquid'."
          }
        },
        "required": []
      }
    }
  },
