  {
    "type": "function",
    "function": {
      "name": "position_math",
      "description": "Compute a perp position's margin, liquidation price, and (if price is given) pnl and ROE.",
      "parameters": {
        "type": "object",
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "long",
              "short"
            ]
          },
          "entry": {
            "type": "number",
            "description": "Entry price in USD."
          },
          "size_usd": {
            "type": "number",
            "description": "Position notional in USD."
          },
          "leverage": {
            "type": "number",
            "description": "Leverage, e.g. 5 for 5x."
          },
          "price": {
            "type": "number",
            "description": "Optional current or target price, for pnl and ROE."
          },
          "maintenance_margin": {
            "type": "number",
            "description": "Optional maintenance margin as a fraction, e.g. 0.005 for 0.5%. Defaults to 0."
          }
        },
        "required": [
          "side",
          "entry",
          "size_usd",
          "leverage"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_markets",
      "description": "Search markets (perps, spot pairs, pools) matching a query. Returns name, type, price, funding (perps) and APY (pools).",
