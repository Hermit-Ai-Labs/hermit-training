  {
    "type": "function",
    "function": {
      "name": "prepare_trade",
      "description": "Prepare a Hyperliquid perp order and open the app's review screen. The user approves it with Face ID; nothing is executed by this call. Never say the trade happened; say it is prepared for review.",
      "parameters": {
        "type": "object",
        "properties": {
          "coin": {
            "type": "string",
            "description": "Ticker, e.g. 'BTC'."
          },
          "side": {
            "type": "string",
            "enum": [
              "long",
              "short"
            ]
          },
          "size_usd": {
            "type": "number",
            "description": "Notional size in USD."
          },
          "leverage": {
            "type": "number"
          },
          "order_type": {
            "type": "string",
            "enum": [
              "market",
              "limit"
            ]
          },
          "limit_price": {
            "type": "number",
            "description": "Required when order_type is limit."
          },
          "take_profit": {
            "type": "number",
            "description": "Optional take-profit trigger price."
          },
          "stop_loss": {
            "type": "number",
            "description": "Optional stop-loss trigger price."
          }
        },
        "required": [
          "coin",
          "side",
          "size_usd",
          "leverage",
          "order_type"
        ]
      }
    }
  },
